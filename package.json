{
  "name": "dsh-chat-mode",
  "version": "3.1.0",
  "private": true,
  "description": "Adds a Chat/Work switch to the DeepSeek Harness top bar. Chat mode embeds the official chat.deepseek.com web chat in a Desktop webview panel, collapses the sidebar, and remembers the web sign-in across restarts, so conversations use the free web account instead of API credit.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhizheng114/dsh-chat-mode.git"
  },
  "homepage": "https://github.com/zhizheng114/dsh-chat-mode#readme",
  "bugs": {
    "url": "https://github.com/zhizheng114/dsh-chat-mode/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek",
    "plugin",
    "cordis",
    "chat"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
